# Copy to .env.local and fill in real values.
# Keys are server-side only (never used from client code).

GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=https://your-project.supabase.co
# NOTE: SUPABASE_URL is the Project URL (no /rest/v1 suffix). The Data API URL (with /rest/v1) is NOT the env var value — the Supabase client appends /rest/v1 itself.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# PostHog. The same project key works for browser analytics (NEXT_PUBLIC_*) and
# server-side error tracking. POSTHOG_API_KEY is server-only and takes
# precedence when set; otherwise the NEXT_PUBLIC_* values are reused.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_API_KEY=phc_your_project_key_here
# POSTHOG_HOST=https://us.i.posthog.com